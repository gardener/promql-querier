{
    "name": "promql-querier-ui",
    "version": "0.0.0",
    "private": true,
    "license": "Apache-2.0",
    "description": "PromQL Querier web UI",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "fmt": "prettier --write \"src/**/*.{ts,tsx,css}\"",
        "fmt-check": "prettier --list-different \"src/**/*.{ts,tsx,css}\"",
        "check": "npm run typecheck && npm run fmt-check",
        "test": "vitest run"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.4",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/language": "^6.13.1",
        "@codemirror/lint": "^6.9.7",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@lezer/common": "^1.5.5",
        "@lezer/highlight": "^1.2.5",
        "@mantine/core": "^9.8.0",
        "@mantine/dates": "^9.8.0",
        "@mantine/hooks": "^9.6.0",
        "@prometheus-io/codemirror-promql": "0.316.0",
        "@tabler/icons-react": "^3.51.0",
        "dayjs": "^1.11.23",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "uplot": "1.6.32"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "vite": "^8.3.7",
        "vitest": "^5.1.0"
    },
    "allowScripts": {
        "esbuild@0.21.5": true
    }
}
